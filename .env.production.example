# Salin menjadi .env.production di VPS. Berkas .env.production tidak boleh di-commit.
APP_NAME="Voucher Digital Sat-Set"
APP_ENV=production
APP_KEY=base64:GANTI_DENGAN_32_BYTE_BASE64
APP_DEBUG=false

# Harus identik dengan domain pada label Traefik di compose.production.yml, tanpa https://.
VOUCHER_DOMAIN=voucher.example.com
APP_URL=https://voucher.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# Isi dengan CIDR/IP network Traefik setelah diperiksa di VPS, mis. 172.18.0.0/16.
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kgj_voucher
DB_USERNAME=kgj_voucher
DB_PASSWORD=GANTI_DENGAN_PASSWORD_POSTGRES_KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=pgsql
LOG_CHANNEL=stderr
LOG_LEVEL=warning

META_PIXEL_ID=
META_DATASET_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v26.0
META_TEST_EVENT_CODE=

# Template WACO harus telah disetujui dan APP_URL harus HTTPS.
WACO_ENABLED=false
WACO_TOKEN=
WACO_TEMPLATE=
WACO_SENDER=
